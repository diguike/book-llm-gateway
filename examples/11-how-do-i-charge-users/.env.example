# ============================================================
# v0.11 新增: 钱包 + mock 支付平台
# ============================================================

# mock 支付平台地址 (跑 npm run mock-pay 后用)
MOCK_PAY_BASE_URL=http://localhost:5010
MOCK_PAY_PORT=5010
# 平台异步回调延迟 (ms). 设为 0 = 不自动回调 (手动触发 POST /api/orders/:no/pay)
MOCK_PAY_AUTO_DELAY_MS=3000
# 退款回调延迟 (ms)
MOCK_PAY_REFUND_DELAY_MS=2000
# 重发回调延迟 (ms). 0 = 不重发. 设大于 0 时演示「平台重复回调」, 验证幂等
MOCK_PAY_RETRY_MS=0
# HMAC secret, mock 平台与 PaymentAdaptor 共享. 真实平台是平台分配的 webhook secret.
MOCK_PAY_SECRET=test-mock-secret
# 网关侧的回调地址前缀, mock 平台会 POST 到 ${PAYMENT_NOTIFY_BASE}/payment/notify/mock
PAYMENT_NOTIFY_BASE=http://localhost:3000

# ============================================================
# v0.7 新增: SSE 流式
# ============================================================

# SSE 心跳间隔 (ms). 中间链路 (Nginx default proxy_read_timeout 60s) 不会切断
# 仍有流量的连接, 我们每 15s 写一行 ': keepalive\n\n' 防止超时.
SSE_HEARTBEAT_MS=15000

# mock 上游地址 (跑 npm run mock 后用). 主路由有 prefix='mock-' 的路由规则.
MOCK_BASE_URL=http://localhost:4010
MOCK_PORT=4010
MOCK_CHUNK_INTERVAL_MS=250

# ============================================================
# v0.6 沿用: 限流 + 月度配额
# ============================================================

GLOBAL_QPS_LIMIT=0
GLOBAL_TPM_LIMIT=0
PER_MODEL_QPS_LIMIT=0
PER_MODEL_TPM_LIMIT=0

# ============================================================
# v0.5 沿用: 计费链路
# ============================================================

INITIAL_BALANCE_CNY=100
DEFAULT_MAX_TOKENS=4096

# ============================================================
# v0.4 沿用: 持久层 + 内部 Key 体系
# ============================================================

DATABASE_URL=./data/gateway.db
ADMIN_TOKEN=admin-change-me

# ============================================================
# 上游 Key
# ============================================================

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-replace-me

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-replace-me

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VERSION=2023-06-01

PORT=3000
