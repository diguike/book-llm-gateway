# ============================================================
# v0.6 新增: 限流 + 月度配额
# ============================================================

# 全局 QPS 上限 (整个进程对所有客户端总和). 0 = 不限.
# 同时也用作 attack.ts 攻防演示前的「兜底防爆」, 防止压测吃光真实上游配额.
GLOBAL_QPS_LIMIT=0

# 全局 TPM 上限 (整个进程每分钟 token 总和). 0 = 不限.
GLOBAL_TPM_LIMIT=0

# 单 model 的 QPS / TPM 上限 (适用于所有 model). 0 = 不限.
# 防热门模型挤占其他模型的上游配额.
PER_MODEL_QPS_LIMIT=0
PER_MODEL_TPM_LIMIT=0

# ============================================================
# v0.5 沿用: 计费链路
# ============================================================

# 默认初始余额 (元).
INITIAL_BALANCE_CNY=100

# preConsume 时若客户端没传 max_tokens, 用这个值预估 output 上限.
DEFAULT_MAX_TOKENS=4096

# ============================================================
# v0.4 沿用: 持久层 + 内部 Key 体系
# ============================================================

DATABASE_URL=./data/gateway.db

# 管理接口主令牌.
ADMIN_TOKEN=admin-change-me

# ============================================================
# 上游 Key
# ============================================================

OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-replace-me

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-replace-me

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VERSION=2023-06-01

PORT=3000
