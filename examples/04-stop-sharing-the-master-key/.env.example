# ============================================================
# v0.4 新增: 持久层 + 内部 Key 体系
# ============================================================

# 本地 SQLite 数据库文件路径 (相对 example 根目录)
DATABASE_URL=./data/gateway.db

# 管理接口 (admin API) 的主令牌. 创建用户 / 签发 Key / 吊销 Key 都需要它.
# 生产环境必须改成强随机串, 否则任何人都能签发新 Key.
ADMIN_TOKEN=admin-change-me

# ============================================================
# 上游 Key (沿用 v0.3, 与本章新引入的「内部 Key」是两套体系)
# ============================================================

# OpenAI 上游
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-replace-me

# DeepSeek 上游 (OpenAI 兼容)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-replace-me

# Anthropic 上游 (协议差异最大)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VERSION=2023-06-01

# 服务监听端口
PORT=3000
