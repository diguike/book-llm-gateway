{
  "name": "ch12-ship-it",
  "version": "1.0.0",
  "private": true,
  "description": "《AI Token 中转站实战》第 12 章 v1.0: 一键上线最小原型 (monorepo 整合 + Docker + 三种部署目标)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "drizzle:generate": "drizzle-kit generate",
    "issue-key": "tsx src/cli/issue-key.ts",
    "seed-wallet": "tsx src/cli/seed-wallet.ts",
    "mock": "tsx src/scripts/mock-upstream.ts",
    "mock-pay": "tsx src/scripts/mock-payment-platform.ts",
    "smoke": "tsx src/scripts/e2e-smoke.ts",
    "stress": "tsx src/scripts/stress.ts",
    "attack": "tsx src/scripts/attack.ts",
    "stream-test": "tsx src/scripts/stream-test.ts",
    "failover-test": "tsx src/scripts/failover-test.ts",
    "payment-flow-test": "tsx src/scripts/payment-flow-test.ts",
    "wallet-concurrency-test": "tsx src/scripts/wallet-concurrency-test.ts",
    "docker:build": "docker build -t llm-gateway:v1.0 .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "js-tiktoken": "^1.0.21",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "autocannon": "^7.15.0",
    "@types/autocannon": "^7.12.6",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
