# ============================================================
# v1.0 配置 (所有字段已收口到 src/config/env.ts, 启动时 zod 校验)
# ============================================================

# 运行模式: dev / prod / test
# dev   = 开发模式, ADMIN_TOKEN 可以用默认值, LOG_LEVEL 通常调 debug
# prod  = 生产模式, ADMIN_TOKEN 不能是 'admin-change-me' (启动失败)
# test  = e2e 测试, 用更短的健康检查 / 心跳间隔
NODE_ENV=dev

# 日志级别: fatal / error / warn / info / debug / trace
LOG_LEVEL=info

# 主网关监听端口
PORT=3000

# ============================================================
# 持久层
# ============================================================
DATABASE_URL=./data/gateway.db

# ============================================================
# 鉴权
# 生产部署必须改! 至少 8 位. prod 模式下不允许等于 'admin-change-me'.
# ============================================================
ADMIN_TOKEN=admin-change-me

# ============================================================
# 上游 (按需填. v1.0 至少要让一家可用, 否则只有 mock channel 能用)
# ============================================================
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01

# ============================================================
# mock LLM 上游 (e2e 测试 + 默认 channel 用)
# ============================================================
MOCK_BASE_URL=http://localhost:4010
MOCK_PORT=4010
MOCK_CHUNK_INTERVAL_MS=250

# ============================================================
# 计费
# ============================================================
INITIAL_BALANCE_CNY=100
DEFAULT_MAX_TOKENS=4096

# ============================================================
# 限流 (0 = 关)
# ============================================================
GLOBAL_QPS_LIMIT=0
GLOBAL_TPM_LIMIT=0
PER_MODEL_QPS_LIMIT=0
PER_MODEL_TPM_LIMIT=0

# ============================================================
# 流式
# ============================================================
SSE_HEARTBEAT_MS=15000

# ============================================================
# 渠道 (后台健康检查)
# ============================================================
HEALTH_CHECK_INTERVAL_MS=60000
DEFAULT_GROUP=default
MAX_CHANNEL_ATTEMPTS=3

# ============================================================
# /readyz 探针
# ============================================================
# 是否要求 wallets 表已建好 (默认 true). 若你只跑「企业基建」场景且不接钱包, 可以设 false.
READINESS_REQUIRE_WALLET=true

# ============================================================
# 支付 (mock 模式. 真实接入参考附录 A)
# ============================================================
MOCK_PAY_BASE_URL=http://localhost:5010
MOCK_PAY_PORT=5010
MOCK_PAY_AUTO_DELAY_MS=3000
MOCK_PAY_REFUND_DELAY_MS=2000
MOCK_PAY_RETRY_MS=0
MOCK_PAY_SECRET=test-mock-secret
PAYMENT_NOTIFY_BASE=http://localhost:3000
